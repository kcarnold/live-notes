<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.kenarnold.proclaim-service</string>

    <!-- Launch wrapper: updates the checkout from the release branch, then runs
         the service. Update failures degrade to "runs the last version". -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{LAUNCH_SCRIPT}}</string>
    </array>

    <!-- Auto-restart on exit -->
    <key>KeepAlive</key>
    <true/>

    <!-- Minimum time between restart attempts (prevent restart spam) -->
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Environment variables (otherwise provided via .env file) -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Set PATH to include the venv if using one, or system paths -->
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

        <!-- Auto-update: the wrapper needs absolute tool paths (launchd's PATH is
             minimal) and the release branch to track. Set PROCLAIM_AUTO_UPDATE to
             0 to freeze this install at whatever is checked out. -->
        <key>UV_BIN</key>
        <string>{{UV_PATH}}</string>
        <key>GIT_BIN</key>
        <string>{{GIT_PATH}}</string>
        <key>PROCLAIM_SERVICE_SCRIPT</key>
        <string>{{SERVICE_SCRIPT}}</string>
        <key>PROCLAIM_UPDATE_BRANCH</key>
        <string>{{UPDATE_BRANCH}}</string>
        <key>PROCLAIM_AUTO_UPDATE</key>
        <string>{{AUTO_UPDATE}}</string>

        <key>YSWEET_URL</key>
        <string>{{YSWEET_URL}}</string>

        <!-- Shared key authorizing this machine's writes (full Y-Sweet tokens and
             /api/translateItem). Installed by install_proclaim_service.sh --write-key=;
             never fetched from the server, since /api/config is public. -->
        <key>PROCLAIM_WRITE_KEY</key>
        <string>{{WRITE_KEY}}</string>

        <!-- Set PROCLAIM_BASE_URL if on different machine -->
        <key>PROCLAIM_BASE_URL</key>
        <string>http://127.0.0.1:52195</string>

        <key>POSTHOG_API_KEY</key>
        <string>{{POSTHOG_KEY}}</string>
        <key>POSTHOG_HOST</key>
        <string>{{POSTHOG_HOST}}</string>
    </dict>

    <!-- Working directory for relative paths -->
    <key>WorkingDirectory</key>
    <string>{{REPO_PATH}}</string>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/stderr.log</string>

    <!-- Run as current user -->
    <key>UserName</key>
    <string>{{USERNAME}}</string>

    <!-- Restart on system wake/network changes -->
    <key>StartInterval</key>
    <integer>0</integer>
</dict>
</plist>
