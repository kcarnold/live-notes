YSWEET_CONNECTION_STRING=...
GEMINI_API_KEY=...
ELEVENLABS_API_KEY=...

# Write authorization: shared per-device keys, not user logins (docs/WRITE_KEYS.md).
# Reading stays open to anyone; these gate editing, the microphone, and the endpoints that
# spend money. Comma-separated, each entry `label:key` or a bare `key`; the label only ever
# shows up in logs. Generate with `openssl rand -hex 24`.
# WRITE_KEYS=proclaim:...,booth:...,tablet:...,feeder:...

# off | observe | enforce (default: observe; forced to off when WRITE_KEYS is empty).
# `observe` checks and logs every privileged request but allows it anyway — ship keys to the
# devices, watch the logs for `key=none`, and only then switch to `enforce`.
# WRITE_AUTH_MODE=observe

# Per-caller request caps for the two endpoints a write key can't protect, because
# listeners legitimately call them (docs/WRITE_KEYS.md). Set far above a real service: a
# congregation shares one public address, so these are sized to stop a script, not a busy
# Sunday. 0 disables.
# TTS_RATE_LIMIT_PER_MIN=600
# TRANSLATE_RATE_LIMIT_PER_MIN=1200

# The congregation's timezone (IANA), used to decide which day a session belongs to and
# when a pin lapses (issue #111). The server now owns "the current doc" for everyone, so it
# has to reckon dates on the church's clock rather than the container's, which is UTC —
# otherwise an evening service in the Americas is filed under tomorrow. Defaults to the
# host's zone. See docs/CURRENT_SESSION.md.
# SESSION_TIMEZONE=America/Detroit

# Where the pin/proposal state is kept (optional). Defaults inside the audio-cache dir so
# it rides the existing Docker volume and a pin survives a restart mid-service.
# SESSION_REGISTRY_PATH=audio-cache/current-session.json

# TTS Rate Limiting (optional, default: 2 concurrent requests)
# TTS_MAX_CONCURRENT=2

# Stronger Gemini model for whole-item slide drafting (optional, default: gemini-3.5-flash).
# Used by /api/translateItem; the incremental notes path stays on the cheaper default model.
# GEMINI_STRONG_MODEL=gemini-3.5-flash

# Live speech-to-speech translation via Gemini Live + LiveKit (optional).
# When unset, the listen-{language} / broadcast panes are disabled but the app still runs.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# Live-audio cost path (optional, default off). Set a dBFS level to make bridges suspend their
# Gemini session after ~30s below it and reopen on speech; -30 is a guess, not a measured value.
# Unset means no suspending at all. Note the sign — dBFS is negative below full scale, so a
# higher number gates harder and 0 would treat all speech as silence. The goaway/reconnect
# fixes and the always-on default translator are independent of this and always on.
# LIVE_AUDIO_SILENCE_THRESHOLD_DBFS=-30

# What a session is assumed to be spoken in when nobody says otherwise (BCP-47, default `en`).
# The broadcast pane asks the speaker directly and publishes their answer per session, so this
# only decides the fallback: older clients, and the macOS audio feeder, which publishes as
# organizer with no UI to ask. Set it when a whole deployment's services are in one language.
# LIVE_AUDIO_SOURCE_LANGUAGE=en

# PostHog Analytics (optional)
# VITE_PUBLIC_POSTHOG_KEY=...
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog CLI for sourcemap uploads (optional, used during Docker build)
# POSTHOG_CLI_TOKEN=...
# POSTHOG_CLI_ENV_ID=...
# POSTHOG_CLI_HOST=https://us.i.posthog.com
