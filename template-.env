YSWEET_CONNECTION_STRING=...
GEMINI_API_KEY=...
# Google Cloud Text-to-Speech (Chirp 3 HD) authentication
# Path to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# TTS Rate Limiting (optional, default: 2 concurrent requests)
# TTS_MAX_CONCURRENT=2

# PostHog Analytics (optional)
# VITE_PUBLIC_POSTHOG_KEY=...
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog CLI for sourcemap uploads (optional, used during Docker build)
# POSTHOG_CLI_TOKEN=...
# POSTHOG_CLI_ENV_ID=...
# POSTHOG_CLI_HOST=https://us.i.posthog.com
