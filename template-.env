YSWEET_CONNECTION_STRING=...
GEMINI_API_KEY=...
ELEVENLABS_API_KEY=...

# TTS Rate Limiting (optional, default: 2 concurrent requests)
# TTS_MAX_CONCURRENT=2

# Stronger Gemini model for whole-item slide drafting (optional, default: gemini-3.5-flash).
# Used by /api/translateItem; the incremental notes path stays on the cheaper default model.
# GEMINI_STRONG_MODEL=gemini-3.5-flash

# OpenRouter (optional). One key routes to every vendor OpenRouter carries. Not used by the
# running server yet — it is what the provider bench (bench/README.md) authenticates with, and
# what the AI SDK provider layer (llm/modelSpec.ts) will use when the text paths move over.
# See docs/llm-providers.md.
# OPENROUTER_API_KEY=sk-or-...

# Live speech-to-speech translation via Gemini Live + LiveKit (optional).
# When unset, the listen-{language} / broadcast panes are disabled but the app still runs.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# Live-audio cost path (optional, default off). Set a dBFS level to make bridges suspend their
# Gemini session after ~30s below it and reopen on speech; -30 is a guess, not a measured value.
# Unset means no suspending at all. Note the sign — dBFS is negative below full scale, so a
# higher number gates harder and 0 would treat all speech as silence. The goaway/reconnect
# fixes and the always-on default translator are independent of this and always on.
# LIVE_AUDIO_SILENCE_THRESHOLD_DBFS=-30

# PostHog Analytics (optional)
# VITE_PUBLIC_POSTHOG_KEY=...
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog CLI for sourcemap uploads (optional, used during Docker build)
# POSTHOG_CLI_TOKEN=...
# POSTHOG_CLI_ENV_ID=...
# POSTHOG_CLI_HOST=https://us.i.posthog.com
